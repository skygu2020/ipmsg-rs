<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkTextBuffer" id="textbuffer1"/>
  <object class="GtkTextBuffer" id="textbuffer2"/>
  <object class="GtkWindow" id="chat_window">
    <property name="resizable">1</property>
    <property name="default-width">1040</property>
    <property name="default-height">720</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="margin-start">20</property>
            <property name="margin-end">20</property>
            <property name="margin-top">14</property>
            <property name="margin-bottom">14</property>
            <style><class name="toolbar"/></style>
            <child>
              <object class="GtkImage">
                <property name="icon-name">avatar-default-symbolic</property>
                <property name="pixel-size">36</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">正在进行的对话</property>
                    <property name="xalign">0</property>
                    <style><class name="title-3"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">局域网即时通讯</property>
                    <property name="xalign">0</property>
                    <style><class name="dim-label"/><class name="caption"/></style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="icon-name">preferences-system-symbolic</property>
                <property name="tooltip-text">聊天选项</property>
                <style><class name="flat"/></style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator">
            <property name="orientation">horizontal</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">0</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="margin-start">20</property>
                <property name="margin-end">16</property>
                <property name="margin-top">16</property>
                <property name="margin-bottom">16</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <property name="min-content-width">420</property>
                    <property name="min-content-height">360</property>
                    <property name="child">
                      <object class="GtkTextView" id="text_view_history">
                        <property name="focusable">1</property>
                        <property name="editable">0</property>
                        <property name="cursor-visible">0</property>
                        <property name="buffer">textbuffer2</property>
                        <property name="accepts-tab">0</property>
                        <property name="wrap-mode">word-char</property>
                        <property name="left-margin">14</property>
                        <property name="right-margin">14</property>
                        <property name="top-margin">14</property>
                        <property name="bottom-margin">14</property>
                      </object>
                    </property>
                    <style><class name="card"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <style><class name="card"/></style>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">1</property>
                        <property name="min-content-height">84</property>
                        <property name="max-content-height">160</property>
                        <property name="child">
                          <object class="GtkTextView" id="text_view_presend">
                            <property name="focusable">1</property>
                            <property name="buffer">textbuffer1</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="left-margin">8</property>
                            <property name="right-margin">8</property>
                            <property name="top-margin">8</property>
                            <property name="bottom-margin">8</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkButton" id="btn_file">
                            <property name="icon-name">document-attach-symbolic</property>
                            <property name="tooltip-text">添加文件</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_dir">
                            <property name="icon-name">folder-symbolic</property>
                            <property name="tooltip-text">添加文件夹</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="hexpand">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_clear">
                            <property name="label">清空</property>
                            <property name="tooltip-text">清空输入内容</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_send">
                            <property name="label">发送</property>
                            <property name="width-request">112</property>
                            <property name="tooltip-text">发送消息</property>
                            <style><class name="suggested-action"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="width-request">250</property>
                <property name="margin-start">14</property>
                <property name="margin-end">14</property>
                <property name="margin-top">16</property>
                <property name="margin-bottom">16</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">待发送文件</property>
                        <property name="xalign">0</property>
                        <style><class name="heading"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="min-content-height">100</property>
                        <property name="child">
                          <object class="GtkListBox" id="list_box_presend">
                            <property name="selection-mode">none</property>
                            <property name="valign">start</property>
                          </object>
                        </property>
                        <style><class name="card"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">收到的文件</property>
                        <property name="xalign">0</property>
                        <style><class name="heading"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="min-content-height">100</property>
                        <property name="child">
                          <object class="GtkTreeView" id="tree_view_received">
                            <property name="focusable">1</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection"/>
                            </child>
                          </object>
                        </property>
                        <style><class name="card"/></style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
